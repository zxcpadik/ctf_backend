# Server Configuration
PORT=3000

# JWT Secret (Recommended: generate a long, random string, e.g., using `openssl rand -base64 32`)
JWT_SECRET="your_secure_jwt_secret_here"

# Admin Password Hash (Generate with a tool like bcrypt, e.g., for "admin123")
# You'll need to hash a password and put the hash here.
# Example: ADMIN_PASSWORD_HASH=$2b$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_PASSWORD_HASH=""

# Path where task files will be stored (relative to project root)
TASK_FILES_PATH="./tasks_data"

# Time-to-live for one-time authentication codes in minutes
AUTH_CODE_TTL_MINUTES=1

# Time-to-live for team leader's share code in minutes (can be float like 1.5)
LEADER_SHARE_CODE_TTL_MINUTES=1.5

# Interval for leaderboard snapshots in seconds (e.g., 60 for every minute)
LEADERBOARD_SNAPSHOT_INTERVAL_SECONDS=60

# Node environment (development, production, test)
NODE_ENV=development